# Copy to .env (never commit .env). Local defaults match infra/docker-compose.yml.
DATABASE_URL=postgres://marketing_ai:marketing_ai@localhost:5436/marketing_ai

# Object storage: the code uses the S3 API only, so switching to production is these 6 variables.
# --- local (local S3 emulator from `pnpm infra:up`) ---
S3_ENDPOINT=http://localhost:9010
S3_REGION=us-east-1
S3_BUCKET=marketing-ai-assets
S3_ACCESS_KEY_ID=marketing-ai
S3_SECRET_ACCESS_KEY=marketing-ai-secret
S3_FORCE_PATH_STYLE=true
# --- production example (Cloudflare R2); AWS S3: omit S3_ENDPOINT, set the real region, FORCE_PATH_STYLE=false ---
# S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
# S3_REGION=auto
# S3_BUCKET=brandwise-assets-prod
# S3_ACCESS_KEY_ID=...
# S3_SECRET_ACCESS_KEY=...
# S3_FORCE_PATH_STYLE=false

# Optional channels (a connector switches on when its credentials are set; `provision.sh apply` passes them to the plugin)
# Telegram: create a bot with @BotFather. Each campaign chooses its chat: bb brandwise campaign channel set telegram chatId=@channel
# (add the bot as admin of the channel, or let a user press Start on the bot first)
# TELEGRAM_BOT_TOKEN=123456:ABC...
# E-mail through Resend: API key from resend.com/api-keys; the webhook signing secret (whsec_...) comes from the webhook you add
# in the Resend dashboard, URL: <public address of this instance>/api/v1/plugins/brandwise/http/webhooks/email/resend
# Events: email.sent, delivered, delivery_delayed, bounced, complained, opened, clicked, failed, suppressed.
# Open/click tracking is off by default: enable it on the sending domain (Resend > Domains > Configuration) with a tracking subdomain.
# RESEND_API_KEY=re_...
# RESEND_WEBHOOK_SECRET=whsec_...
# Meta (Facebook Pages and Instagram): a system-user token of the client's business with pages_manage_posts, pages_read_engagement,
# instagram_basic and instagram_content_publish on the Pages and Instagram accounts it may post to (docs/channels.md). Each campaign
# chooses where: bb brandwise campaign channel set facebook pageId=<id> | instagram accountId=<id>; `bb brandwise meta test` lists them.
# META_PUBLISH_TOKEN=EAAB...
# TikTok (Content Posting API, Direct Post) and YouTube (Data API v3): the apps' client credentials. Accounts are then connected per
# campaign by a person who signs in: bb brandwise tiktok connect --campaign <c>, bb brandwise youtube connect --campaign <c> (docs/channels.md).
# TIKTOK_CLIENT_KEY=aw...
# TIKTOK_CLIENT_SECRET=...
# YOUTUBE_CLIENT_ID=....apps.googleusercontent.com
# YOUTUBE_CLIENT_SECRET=GOCSPX-...
# Threads (a Meta app with the Threads use case: its own app id and secret) and LinkedIn (Share on LinkedIn + Sign In with OpenID Connect);
# accounts are connected per campaign the same way: bb brandwise threads|linkedin connect --campaign <c>
# THREADS_APP_ID=...
# THREADS_APP_SECRET=...
# LINKEDIN_CLIENT_ID=...
# LINKEDIN_CLIENT_SECRET=...

# Public address of the short-link redirect (/api/v1/plugins/brandwise/http/l behind a tunnel or proxy); empty = links are not shortened
LINKS_BASE_URL=
