# Declarative profile of the BrandWise BB instance. Edit here, then run: infra/bb-instance/provision.sh apply
# Paths starting with "/" are absolute, the rest are relative to the repo root.
BW_DATA_DIR="$HOME/.bb-brandwise"      # holds threads, secrets, plugin data: keep it OUT of the repo
BW_SERVER_PORT=38896                       # the personal BB uses 38886/38887
BW_DAEMON_PORT=38897
BW_PLUGIN_DIR="apps/bb-plugin-brandwise"
BW_DEFAULT_CAMPAIGN="Main brand"          # always-on campaign created when the instance has none
BW_MODES="${BW_MODES:-minimal,full}"                    # modes the Settings switch offers (one entry = locked). Read when the bb server starts: restart with down + up
BW_MODE="${BW_MODE:-minimal}"                            # display mode of the plugin: full | minimal (see apps/bb-plugin-brandwise/modes.ts)
BW_MODE_ENFORCE="${BW_MODE_ENFORCE:-0}"       # 1 = every apply resets the mode to BW_MODE; 0 = only the first install does (Settings choice wins)
BW_TAILNET_HTTP_PORT="${BW_TAILNET_HTTP_PORT:-}"   # empty = this Mac only. A port (e.g. 38896) publishes the instance to your tailnet over HTTP with `tailscale serve` (no certs needed, tailnet devices only). Set it in infra/bb-instance/profile.local.env.
